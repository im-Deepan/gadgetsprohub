{
  "manifest_version": 3,
  "name": "GadgetsProHub Product Importer",
  "version": "1.0.0",
  "description": "One-click Amazon product import tool for GadgetsProHub Affiliate Store.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://*.amazon.com/*",
    "https://*.amazon.in/*",
    "https://*.amazon.co.uk/*",
    "https://*.amazon.ca/*",
    "https://*.run.app/*",
    "https://gadgetsprohub.onrender.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.amazon.com/*",
        "https://*.amazon.in/*",
        "https://*.amazon.co.uk/*",
        "https://*.amazon.ca/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Import to GadgetsProHub"
  }
}
