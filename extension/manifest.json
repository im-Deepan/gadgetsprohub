{
  "manifest_version": 3,
  "name": "GadgetsProHub Product Importer",
  "version": "1.0.0",
  "description": "One-click Amazon product import tool for GadgetsProHub Affiliate Store.",
  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "notifications",
    "alarms"
  ],
  "host_permissions": [
    "https://*.amazon.com/*",
    "https://*.amazon.in/*",
    "https://*.amazon.co.uk/*",
    "https://*.amazon.ca/*",
    "https://*.amazon.de/*",
    "https://*.amazon.fr/*",
    "https://*.amazon.it/*",
    "https://*.amazon.es/*",
    "https://*.amazon.co.jp/*",
    "https://*.amazon.ae/*",
    "https://*.amazon.com.au/*",
    "https://link.amazon/*",
    "https://*.link.amazon/*",
    "https://amzn.to/*",
    "https://a.co/*",
    "https://*.gadgetsprohub.com/*",
    "https://gadgetsprohub.onrender.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.amazon.com/*",
        "https://*.amazon.in/*",
        "https://*.amazon.co.uk/*",
        "https://*.amazon.ca/*",
        "https://*.amazon.de/*",
        "https://*.amazon.fr/*",
        "https://*.amazon.it/*",
        "https://*.amazon.es/*",
        "https://*.amazon.co.jp/*",
        "https://*.amazon.ae/*",
        "https://*.amazon.com.au/*",
        "https://link.amazon/*",
        "https://*.link.amazon/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Import to GadgetsProHub",
    "default_icon": {
      "16": "icons/icon16.png",
      "24": "icons/icon24.png",
      "32": "icons/icon32.png"
    }
  }
}
