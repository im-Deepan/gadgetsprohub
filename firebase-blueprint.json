{
  "entities": {
    "ContactMessage": {
      "title": "ContactMessage",
      "description": "Contact message submitted via help desk form",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the sender"
        },
        "email": {
          "type": "string",
          "description": "Email coordinates of the sender"
        },
        "phone": {
          "type": "string",
          "description": "Optional phone contact of the sender"
        },
        "subject": {
          "type": "string",
          "description": "Subject of the inquiry"
        },
        "message": {
          "type": "string",
          "description": "Message description text"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of submission"
        }
      },
      "required": ["name", "email", "subject", "message"]
    }
  },
  "firestore": {
    "messages/{messageId}": {
      "schema": "ContactMessage",
      "description": "A collections container storing verified contact inquiries"
    }
  }
}
