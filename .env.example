# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MONGODB_URI: The connection string of your MongoDB cluster or local instance.
# Set via environment variables in production.
MONGODB_URI=""

# JWT_SECRET: Salt secret string used to hash and encrypt authorization bearer tokens.
# Must be a cryptographically secure random string (e.g., generated via 'openssl rand -base64 32')
# Do not store real secrets here. Use a Secrets Manager in production.
JWT_SECRET=""

# ADMIN_EMAILS: Comma-separated list of admin emails
# Use Secrets Manager to configure these in production to prevent target enumeration.
ADMIN_EMAILS=""

# Firebase Environment Variables
# These values should be provided by your infrastructure or secrets manager
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_MEASUREMENT_ID=""
VITE_FIREBASE_DATABASE_ID=""

# Google AdSense Config Definitions
VITE_ADSENSE_CLIENT_ID=""
# ADSENSE_CLIENT_ID: Server-side fallback publisher ID used for ads.txt generation (prefixed with ca-pub-)
ADSENSE_CLIENT_ID=""

# N8N Automation Integrations
# N8N_REALTIME_WEBHOOK_URL: Webhook URL triggered when a user visits a product whose price is older than 24 hours.
N8N_REALTIME_WEBHOOK_URL=""
# N8N_SECRET_TOKEN: Secret token used to authenticate incoming requests from n8n.
N8N_SECRET_TOKEN=""

# Telegram Admin Bot Config
# TELEGRAM_BOT_TOKEN: Bot token received from @BotFather
TELEGRAM_BOT_TOKEN=""
# TELEGRAM_ALLOWED_USER_ID: Private numeric user ID of the admin allowed to use the bot (e.g. 123456789)
TELEGRAM_ALLOWED_USER_ID=""
# TELEGRAM_ALLOWED_USERNAME: Username of the admin allowed to use the bot (without @)
TELEGRAM_ALLOWED_USERNAME=""


# Set these via environment variables or a Secrets Manager in production.
# WARNING: Never write actual credentials to this file or commit them to version control.
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
SENDER_EMAIL=""
AUTHOR_EMAIL=""


