    "chrome-extension-mv3",
    "express",
    "react",
    "mongodb",
    "gemini-ai",
    "sharp"
  ],
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "cd extension && npm run build && cd .. && vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && node zip-extension.js",
    "build:client": "vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:extension": "cd extension && npm run build",
    "start": "node dist/server.cjs",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:extension": "cd extension && npm test",
    "test:all": "jest && cd extension && npm test",
    "clean": "rm -rf dist server.cjs",
    "lint": "tsc --noEmit",
    "audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@google/genai": "^2.11.0",
